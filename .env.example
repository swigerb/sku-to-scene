# SKU to Scene configuration. Copy to .env (never commit .env).
# Mock mode replays demo-cache/ entries with recorded provenance (currently authentic foundry renders).
# Only cache-miss placeholders are simulated; no new generation jobs are submitted.
SKU2SCENE_MODE=mock
# SKU2SCENE_DATA_DIR=.sku2scene            # job ledger, outputs, reroll state
# SKU2SCENE_MOCK_LATENCY_SCALE=0.1         # 1.0 = simulate realistic per-model latency on stage

# --- Live Microsoft Foundry (fal models). Requires admin review of fal terms + Fal.EnableDeploy. ---
# SKU2SCENE_MODE=live
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
#   (a project endpoint .../api/projects/<project> is normalized to the resource root)
# FOUNDRY_FAL_ROUTE_PREFIX=providers/falai/v1   # Learn route list omits /v1; code samples + ComfyUI use it
# Auth: Entra ID via DefaultAzureCredential (az login), scope https://cognitiveservices.azure.com/.default
# FOUNDRY_TENANT_ID=<demo-tenant-id>         # fallback: AZURE_TENANT_ID
# FOUNDRY_SUBSCRIPTION_ID=<demo-subscription-id>  # selects CLI account without changing its default
# A subscription selector takes precedence over tenant selection; neither changes the CLI default.
# With either selector, AzureCliCredential is used; no browser/fallback credential is attempted.
# FOUNDRY_API_KEY=                          # optional alternative to Entra ID. A fal.ai FAL_KEY is NOT used.
# FOUNDRY_POLL_INTERVAL=5
# FOUNDRY_TIMEOUT=600
# Deployment names in your Foundry resource:
# FOUNDRY_DEPLOYMENT_KLING_V3_PRO=kling-v3-pro
# FOUNDRY_DEPLOYMENT_LTX_25_FAST=ltx-2.5-fast
# FOUNDRY_DEPLOYMENT_LTX_25_PRO=ltx-2.5-pro
# FOUNDRY_DEPLOYMENT_MINIMAX_H3_MAX=minimax-h3-max
# FOUNDRY_DEPLOYMENT_MINIMAX_H3_MAX_TURBO=minimax-h3-max-turbo

# --- Optional real brand QA (otherwise QA is labelled rehearsal / manual review, never approval) ---
# AZURE_OPENAI_ENDPOINT=https://<aoai>.openai.azure.com
# AZURE_OPENAI_VISION_DEPLOYMENT=<vision-capable deployment>
# AZURE_OPENAI_API_KEY=
# CONTENT_SAFETY_ENDPOINT=https://<cs>.cognitiveservices.azure.com
# CONTENT_SAFETY_KEY=
